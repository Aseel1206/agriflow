# Fastest path for local dev/demo — no Postgres install needed:
DATABASE_URL=sqlite:///./agriflow.db

# Swap to this for production-parity (see README's Docker / Postgres sections):
# DATABASE_URL=postgresql+psycopg://agriflow:agriflow@localhost:5432/agriflow

JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
